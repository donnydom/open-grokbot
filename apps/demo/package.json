{
  "name": "@open-grokbot/demo",
  "version": "0.1.0",
  "description": "CLI demo: user chat, agent-to-agent messaging, group chat and broadcast over the Open-Grokbot runtime with the mock LLM.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "open-grokbot-demo": "./dist/src/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "demo": "npm run build && node dist/src/index.js"
  },
  "dependencies": {
    "@open-grokbot/llm": "0.1.0",
    "@open-grokbot/messaging": "0.1.0",
    "@open-grokbot/runner": "0.1.0",
    "@open-grokbot/state": "0.1.0"
  }
}
